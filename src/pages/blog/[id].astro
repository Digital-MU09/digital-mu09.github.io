---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={post.data.title} description={post.data.description}>
  <main>
    <article>
      <h1>{post.data.title}</h1>
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <div class="post">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  main {
    padding-top: 32px;
  }

  article {
    max-width: 70ch;
  }

  h1 {
    margin: 0 0 8px;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.25;
  }

  time {
    display: block;
    margin-bottom: 28px;
    font-size: 16px;
  }

  .post :global(h2) {
    margin: 36px 0 12px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
  }

  .post :global(h3) {
    margin: 28px 0 8px;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.3;
  }

  .post :global(p),
  .post :global(ul),
  .post :global(ol),
  .post :global(blockquote),
  .post :global(pre) {
    margin: 0 0 18px;
  }

  .post :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .post :global(ul),
  .post :global(ol) {
    padding-left: 1.4em;
  }

  .post :global(blockquote) {
    padding-left: 16px;
    border-left: 2px solid var(--ink);
  }

  .post :global(code) {
    padding: 1px 5px;
    background: #1c1d23;
    font-size: 0.92em;
  }

  .post :global(pre) {
    max-width: 100%;
    padding: 16px;
    overflow-x: auto;
    border: 2px solid var(--ink);
  }

  .post :global(pre code) {
    padding: 0;
    background: none;
  }

  .post :global(img) {
    max-width: 100%;
    height: auto;
  }

  .post :global(hr) {
    margin: 32px 0;
    border: 0;
    border-top: 2px solid var(--ink);
  }

  @media (min-width: 860px) {
    main {
      padding-top: 56px;
    }

    h1 {
      font-size: 32px;
    }
  }
</style>
