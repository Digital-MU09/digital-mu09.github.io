---
import Base from '../../layouts/Base.astro';
---

<Base title="Blogs" description="Posts and articles.">
  <main>
    <h1>Blogs</h1>
    <p>Empty for now :3</p>
  </main>
</Base>

<style>
  main {
    padding-top: 32px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin: 0;
  }

  @media (min-width: 860px) {
    main {
      padding-top: 56px;
    }

    h1 {
      margin-bottom: 20px;
      font-size: 26px;
    }
  }
</style>
