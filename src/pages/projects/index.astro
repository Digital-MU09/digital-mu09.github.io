---
import Base from '../../layouts/Base.astro';

const projects = [
  {
    name: 'WasteAI',
    description: 'A college project created by two inexperienced students.',
    href: 'https://github.com/AliHaider704/WasteAI',
  },
];
---

<Base title="Projects" description="Things I have built.">
  <main>
    <h1>Projects</h1>
    <ul role="list">
      {
        projects.map((project) => (
          <li class="card">
            <h2>
              <a href={project.href} target="_blank" rel="noopener noreferrer">
                <span aria-hidden="true">→</span> {project.name}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </h2>
            <p>{project.description}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  main {
    padding-top: 32px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
  }

  ul {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    max-width: 560px;
    padding: 20px;
    border: 2px solid var(--ink);
  }

  h2 {
    margin: 0 0 8px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }

  h2 a {
    display: inline-block;
    padding: 4px 0;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  p {
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 860px) {
    main {
      padding-top: 56px;
    }

    h1 {
      margin-bottom: 20px;
      font-size: 26px;
    }
  }
</style>
