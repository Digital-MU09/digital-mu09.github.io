---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <main>
    <h1>Page not found</h1>
    <p>There is nothing at this address.</p>
    <a class="home" href="/"><span aria-hidden="true">→</span> Back home</a>
  </main>
</Base>

<style>
  main {
    padding-top: 32px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin: 0 0 12px;
  }

  .home {
    display: inline-block;
    padding: 8px 0;
    font-size: 18px;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  @media (min-width: 860px) {
    main {
      padding-top: 56px;
    }

    h1 {
      margin-bottom: 20px;
      font-size: 26px;
    }

    .home {
      padding: 0;
    }
  }
</style>
